{
  "name": "tsuzuki",
  "version": "0.1.0",
  "private": true,
  "description": "続き — local-first watch history, resume points and search history. Nothing leaves your devices unencrypted.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/CMApex/Tsuzuki"
  },
  "type": "module",
  "scripts": {
    "build": "node extension/build.mjs",
    "build:firefox": "node extension/build.mjs firefox",
    "build:safari": "node extension/build.mjs safari",
    "watch": "node extension/build.mjs --watch",
    "test": "node --test test/*.test.mjs",
    "lint": "npx --yes web-ext@10 lint --source-dir dist/firefox",
    "package:firefox": "npm run build:firefox && npx --yes web-ext@10 build --source-dir dist/firefox --artifacts-dir dist/artifacts --overwrite-dest",
    "run:firefox": "npx --yes web-ext@10 run --source-dir dist/firefox"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3"
  },
  "engines": {
    "node": ">=22"
  }
}
